# Configure before vibe, vibe build, or vibe run.
# 執行 vibe、vibe build 或 vibe run 前請先設定。
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-model-name
LLM_API_STYLE=responses
LLM_API_KEY=your-key-here
# File alternative; LLM_API_KEY wins, so remove it to use the file.
# 可改用金鑰檔案；LLM_API_KEY 優先，使用檔案前請移除該設定。
# LLM_API_KEY_FILE=/path/to/your-key-file
# Private/LAN proxy: local development only; refused in CI/production.
# 私人或區域網路代理僅限本機開發；CI 與正式環境會拒絕此設定。
# LLM_ALLOW_PRIVATE_HOST=true
