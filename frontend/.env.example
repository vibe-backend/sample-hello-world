# all = fully mocked; counter = real hello + mock counter (default); off = real APIs.
# all = 全部示範資料；counter = 真實問候 + 示範計數器（預設）；off = 真實 API。
PUBLIC_API_MOCK=counter
# Tenant slug; empty string omits the segment. / 租戶 slug；空字串省略此路徑區段。
PUBLIC_API_SLUG=dev
# In-memory mock latency in milliseconds. / 記憶體示範資料的延遲（毫秒）。
PUBLIC_API_MOCK_DELAY_MS=300
# Development proxy target (not exposed to the browser). / 開發代理目標（不公開至瀏覽器）。
API_PROXY_TARGET=http://127.0.0.1:8080
